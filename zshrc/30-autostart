# Fastfetch
# -----------------------------------------------------

center_text() {
  local term_width="${COLUMNS:-$(tput cols < /dev/tty 2>/dev/null || echo 80)}"
  local input width pad spaces

  # 1. Capture all input as a single raw block to preserve colors and formatting
  if [[ ! -t 0 ]]; then
    input="$(cat)"
  elif [[ $# -gt 0 ]]; then
    input="$*"
  else
    return
  fi

  # 2. Measure max width using your perl logic
  # (Expanded from [mGKH] to [a-zA-Z] to safely catch all cursor movement codes)
  width=$(printf "%s\n" "$input" | perl -pe 's/\x1b\[[0-9;]*[a-zA-Z]//g' | wc -L)

  # 3. Calculate the left padding
  pad=0
  if (( width < term_width )); then
    pad=$(( (term_width - width) / 2 ))
  fi

  # 4. Apply padding using Perl
  if (( pad > 0 )); then
    spaces=$(printf "%*s" "$pad" "")
    
    # Prepend spaces to the start of the line (^). 
    # Also inject spaces after any carriage returns (\r) to fix the first-line bug.
    printf "%s\n" "$input" | perl -pe "s/^/$spaces/; s/\\r/\\r$spaces/g"
  else
    printf "%s\n" "$input"
  fi
}

cfetch() {
  local width pad term_width
  term_width="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"

  width=$(fastfetch "$@" | perl -0777 -pe '
    s/\x1b[_P].*?\x1b\\//gs; 
    
    s/\x1b\[(\d+)G/" " x ($1 - 1)/ge; 
    
    s/\x1b\[(\d+)C/" " x $1/ge; 
    
    s/\x1b\[[0-9;]*[a-zA-Z]//g
  ' | wc -L)

  pad=$(( (term_width - width) / 2 ))
  
  (( pad < 0 )) && pad=0

  fastfetch "$@" --logo-padding-left "$pad"
}

if [[ $(tty) == *"pts"* ]]; then
    cfetch
fi

fortune ~/.config/quotes/quotes | boxes -d ansi | center_text

