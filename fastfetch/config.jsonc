{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/korin/.config/fastfetch/icons/arch.png",
        "type": "auto",
        "width": 20,
        "height": 10,
        "padding": {
            "top": 0,
            "left": 0,
            "right": 5,
            "bottom": 0
        }
    },
    "display": {
        "separator": "  ",
        "color": "red"
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": " "
        },
        {
            "type": "kernel",
            "key": " "
        },
        {
            "type": "uptime",
            "key": "󰅐 "
        },
        {
            "type": "terminal",
            "key": " "
        },
        {
            "type": "wm",
            "key": " "
        },
        {
            "key": "󰉉 ",
            "type": "disk",
            "folders": "/home"

        }, 
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
