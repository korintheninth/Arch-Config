/* ---- Configuration ---- */
configuration {
    modi:                       "dmenu";
    font:                       "Pixel Code 10";
    show-icons:                 true;

    /* Enable mouse single-click execution */
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

/* ---- Load colors ---- */
@theme "~/.config/rofi/colors.rasi"
@import "~/.config/rofi/vars.rasi"

/* ---- Window ---- */
window {
    width:                       28em;
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    transparency:                "real";

    border:                      2px;
    border-color:                @primary;
    border-radius:               @menu-radius;

    background-color:            @background;
    padding:                     14px;
    spacing:                     0;
    cursor:                      "default";
}

/* ---- Main Box ---- */
mainbox {
    enabled:                     true;
    orientation:                 vertical;
    children:                    [ "listview" ];
    background-color:            transparent;
    spacing:                     0;
}

/* ---- Input Bar ---- */
inputbar {
    enabled:                     false;
}

/* ---- List View ---- */
listview {
    enabled:                     true;
    columns:                     6;
    lines:                       1;
    cycle:                       true;
    dynamic:                     false;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     8px;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      "default";
}

/* ---- Elements ---- */
element {
    enabled:                     true;
    orientation:                 vertical;
    padding:                     12px;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}

element selected.normal {
    background-color:            @primary;
    text-color:                  @background;
}

element alternate.normal {
    background-color:            inherit;
    text-color:                  inherit;
}

element-icon {
    size:                        2.2em;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

element-text {
    enabled:                     false;
}

/* ---- Error Message ---- */
error-message {
    padding:                     15px;
    border-radius:               @menu-radius;
    background-color:            @background;
    text-color:                  @on-surface;
}
